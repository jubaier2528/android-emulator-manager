{
  "name": "android-emulator-manager",
  "version": "1.0.1",
  "private": true,
  "description": "A desktop Android Virtual Device manager for VS Code users.",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "dev:electron": "npm run build:electron && electron .",
    "build": "npm run build:electron && tsc -p tsconfig.app.json && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.6",
    "wait-on": "^8.0.0"
  },
  "overrides": {
    "minimatch@>=7": "^11.0.5"
  },
  "build": {
    "appId": "com.androidemulatormanager.app",
    "productName": "Android Emulator Manager",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "category": "Development",
      "target": "AppImage"
    }
  }
}
